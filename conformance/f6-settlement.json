    {
      "id": "f6-advance-own-cumulative-exact",
      "class": "watermark-advance",
      "title": "Option W (F6-o): first advance of a first-generation channel to its own-cumulative target; exact floor, zero residue",
      "inputs": {
        "accrued": ["750000", "150000", "450000", "150000"],
        "imported_settled": ["0", "0", "0", "0"],
        "funded_p_before": "0",
        "bps": [50, 10, 30, 10]
      },
      "expect": {
        "target_p": "150",
        "delta": "150",
        "payouts": ["75", "15", "45", "15"],
        "residue": "0"
      }
    },
    {
      "id": "f6-advance-chain-boundary-dust",
      "class": "watermark-advance",
      "title": "Option W (F6-o) chain-boundary dust: a per-channel floor leaves a bounded 1-microunit §10.2 residue (target 151 = 75+15+45+15 + 1) — the F6.6-amendment case",
      "inputs": {
        "accrued": ["755000", "151000", "453000", "151000"],
        "imported_settled": ["0", "0", "0", "0"],
        "funded_p_before": "0",
        "bps": [50, 10, 30, 10]
      },
      "expect": {
        "target_p": "151",
        "delta": "151",
        "payouts": ["75", "15", "45", "15"],
        "residue": "1"
      }
    },
    {
      "id": "f6-advance-own-cumulative-imported-successor",
      "class": "watermark-advance",
      "title": "Option W (v4) altitude: a chained successor advances its OWN carve only (100 = floor((2500000-1500000)/1e4)), never the whole-chain 250 — the predecessor's settled meed is subtracted",
      "inputs": {
        "accrued": ["1250000", "250000", "750000", "250000"],
        "imported_settled": ["750000", "150000", "450000", "150000"],
        "funded_p_before": "0",
        "bps": [50, 10, 30, 10]
      },
      "expect": {
        "target_p": "100",
        "delta": "100",
        "payouts": ["50", "10", "30", "10"],
        "residue": "0"
      }
    },
    {
      "id": "f6-advance-idempotent-reissue",
      "class": "watermark-advance",
      "title": "Option W (F6-o) idempotency by absolute position: re-advancing to a target already funded distributes NOTHING (delta 0) — the crash/reorg/replay closure",
      "inputs": {
        "accrued": ["750000", "150000", "450000", "150000"],
        "imported_settled": ["0", "0", "0", "0"],
        "funded_p_before": "150",
        "bps": [50, 10, 30, 10]
      },
      "expect": {
        "target_p": "150",
        "delta": "0",
        "payouts": ["0", "0", "0", "0"],
        "residue": "0"
      }
    },
    {
      "id": "f6-advance-subsequent-delta-only",
      "class": "watermark-advance",
      "title": "Option W (F6-o): a second advance from funded 150 to cumulative target 250 distributes ONLY the residual delta (100 = 50+10+30+10) — the interim-then-close move on the monotone watermark",
      "inputs": {
        "accrued": ["1250000", "250000", "750000", "250000"],
        "imported_settled": ["0", "0", "0", "0"],
        "funded_p_before": "150",
        "bps": [50, 10, 30, 10]
      },
      "expect": {
        "target_p": "250",
        "delta": "100",
        "payouts": ["50", "10", "30", "10"],
        "residue": "0"
      }
    },
    {
      "id": "f6-advance-shared-destination-aggregates",
      "class": "watermark-advance",
      "title": "F6-o↔F7-d: three roles (0x10/0x12/0x13, bp 50/30/10) share ONE destination (a Development Fund) while 0x11 (bp 10) has its own — the advance floors ONCE per destination (bp_dev=90 → dev ⌊13·90/100⌋=11), never per-role (⌊6.5⌋+⌊3.9⌋+⌊1.3⌋=10, which strands a sub-unit on the chronically-shared dest). dests=[0,1,0,0] maps roles→destinations; payouts are per-destination [dev, other].",
      "inputs": {
        "accrued": ["65000", "13000", "39000", "13000"],
        "imported_settled": ["0", "0", "0", "0"],
        "funded_p_before": "0",
        "bps": [50, 10, 30, 10],
        "dests": [0, 1, 0, 0]
      },
      "expect": {
        "target_p": "13",
        "delta": "13",
        "payouts": ["11", "1"],
        "residue": "1"
      }
    }
  ]
